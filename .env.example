# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=library_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# IGDB / Twitch API Credentials (Data Analysis Module)
IGDB_CLIENT_ID=your_twitch_client_id
IGDB_CLIENT_SECRET=your_twitch_client_secret

# Access Whitelist (loginy lub adresy e-mail rozdzielone przecinkami)
AUTH_WHITELIST=jakub,admin

# Opcjonalny klucz Google Books API (zwiększa limity zapytań o okładki)
GOOGLE_BOOKS_API_KEY=
